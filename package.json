{
  "name": "dentweb-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @dentweb/database generate",
    "db:migrate": "pnpm --filter @dentweb/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @dentweb/database migrate:dev",
    "db:seed": "pnpm --filter @dentweb/database seed",
    "bootstrap:superadmin": "pnpm --filter @dentweb/api bootstrap:superadmin",
    "dist:mac": "pnpm --filter @dentweb/desktop dist:mac",
    "dist:win": "pnpm --filter @dentweb/desktop dist:win"
  },
  "devDependencies": {
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "@types/node": "22.20.5"
  }
}

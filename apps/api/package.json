{
  "name": "@dentweb/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bootstrap:superadmin": "node --env-file-if-exists=../../.env dist/scripts/bootstrap-superadmin.js",
    "openapi": "node --env-file-if-exists=../../.env dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@dentweb/database": "workspace:*",
    "@dentweb/shared-types": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.8.0",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "nodemailer": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@dentweb/content-schema": "workspace:*",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "yauzl": "3.4.0",
    "multer": "2.5.0",
    "@dentweb/motion-schema": "workspace:*",
    "bullmq": "6.7.6"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0",
    "@types/yauzl": "3.4.0",
    "@types/multer": "2.3.0"
  }
}
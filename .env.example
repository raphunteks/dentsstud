# ============ DENTSWEB STUDIO — environment template ============
# Copy to .env (never commit real values).

NODE_ENV=development
PORT=4000

# PostgreSQL (Neon / VPS). Add ?sslmode=require for managed Postgres.
DATABASE_URL=postgresql://dentweb:dentweb@localhost:5432/dentweb
DATABASE_POOL_MAX=10

# Upstash Redis: use the TLS URL (rediss://default:<password>@<host>:6379)
REDIS_URL=redis://localhost:6379
# BullMQ key prefix; API and render workers must share it. Use a different value per environment on a shared Redis.
QUEUE_PREFIX=dentweb
# Run multi-agent production + scheduler consumers inside the API process
PRODUCTION_WORKER=true
PRODUCTION_CONCURRENCY=4
SCHEDULER_ENABLED=true

# Public web origin (Vercel) — used for CORS + email links
WEB_ORIGIN=http://localhost:3000
CORS_EXTRA_ORIGINS=app://dentsweb,app://dentweb
# COOKIE_SECURE=true

# 32-byte base64 key:   openssl rand -base64 32
SECRETS_MASTER_KEY=
# Ed25519 PKCS8 PEM, base64:   openssl genpkey -algorithm ed25519 | base64 | tr -d '\n'
LICENSE_SIGNING_KEY=

# SMTP for login OTP (Gmail: smtp.gmail.com, 465, secure=true, App Password — not your Google password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DENTSWEB STUDIO <no-reply@example.com>"

# Optional: generic OAuth PKCE providers registered TO DENTSWEB (JSON array). Leave empty if none.
# OAUTH_PROVIDERS_JSON=[{"code":"...","authorizeUrl":"https://...","tokenUrl":"https://...","clientId":"...","scopes":[],"redirectUri":"https://app.example.com/settings/claude/callback"}]
ANTHROPIC_API_BASE=https://api.anthropic.com

# First superadmin (used once by: pnpm bootstrap:superadmin)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Superadmin

# Web (Vercel): where Next rewrites /api/v1/* to
API_ORIGIN=http://localhost:4000
# Desktop dev: API base used by Electron main process
DENTSWEB_API_BASE=http://localhost:4000

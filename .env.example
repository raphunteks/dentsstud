# ============ DENTSWEB STUDIO — environment template ============
# Copy to .env (never commit real values).
# Aligned with apps/api/src/config/env.ts and apps/render-worker/src/index.ts.

NODE_ENV=development
PORT=4000
TRUST_PROXY=true

# PostgreSQL (Neon / VPS). Add ?sslmode=require for managed Postgres.
DATABASE_URL=postgresql://dentweb:dentweb@localhost:5432/dentweb
DATABASE_POOL_MAX=10

# Redis (Local Docker / Upstash TLS rediss://default:<password>@<host>:6379)
REDIS_URL=redis://localhost:6379
# BullMQ key prefix; API and render workers must share it.
QUEUE_PREFIX=dentweb

# Multi-agent production + scheduler consumers inside API process
PRODUCTION_WORKER=true
PRODUCTION_CONCURRENCY=4
SCHEDULER_ENABLED=true

# Origins & CORS
PUBLIC_API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
CORS_EXTRA_ORIGINS=app://dentsweb,app://dentweb
# COOKIE_SECURE=true

# Security & Crypto Keys
# 32-byte base64 key:   openssl rand -base64 32
SECRETS_MASTER_KEY=
# Ed25519 PKCS8 PEM, base64:   openssl genpkey -algorithm ed25519 | base64 | tr -d '\n'
LICENSE_SIGNING_KEY=
# Shared secret for render/production workers calling /api/v1/internal/* (min 32 chars)
WORKER_TOKEN=
# Optional Prometheus /api/v1/metrics bearer token (min 24 chars; unset = disabled)
METRICS_TOKEN=

# Object Storage (local disk or S3-compatible bucket)
STORAGE_DRIVER=local
STORAGE_DIR=./.data/storage
UPLOAD_MAX_BYTES=524288000
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# SMTP for login OTP (required when NODE_ENV=production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DENTSWEB STUDIO <no-reply@example.com>"

# AI & TTS Upstream Defaults
ANTHROPIC_API_BASE=https://api.anthropic.com
GEMINI_API_BASE=https://generativelanguage.googleapis.com
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional: generic OAuth PKCE providers registered TO DENTSWEB (JSON array).
# OAUTH_PROVIDERS_JSON=

# Render Worker (apps/render-worker)
API_INTERNAL_URL=http://127.0.0.1:4000
RENDER_CONCURRENCY=2
REMOTION_CONCURRENCY=4
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium

# First superadmin (used once by: pnpm bootstrap:superadmin)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Superadmin

# Web (Next.js rewrites /api/v1/*) & Desktop dev API base
API_ORIGIN=http://localhost:4000
DENTSWEB_API_BASE=http://localhost:4000

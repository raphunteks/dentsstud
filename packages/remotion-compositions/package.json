{
  "name": "@dentweb/remotion-compositions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/node/render.d.ts",
      "default": "./dist/node/render.js"
    },
    "./components": {
      "default": "./src/MotionComp.tsx"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dentweb/motion-schema": "workspace:*",
    "@fontsource-variable/chivo": "5.3.0",
    "@remotion/bundler": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "files": [
    "dist",
    "bundle",
    "src"
  ]
}

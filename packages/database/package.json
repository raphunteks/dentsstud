{
  "name": "@dentweb/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate:generate": "drizzle-kit generate",
    "migrate:deploy": "tsx scripts/migrate.ts",
    "seed": "tsx seeds/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
